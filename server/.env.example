# ==============================================================
# SERVER ENVIRONMENT CONFIGURATION (.env)
# ==============================================================

# Port to listen on (Default: 5000; on Render/Railway/Heroku $PORT is automatically injected)
PORT=5000

# Environment mode: production | development
NODE_ENV=production

# JWT Authentication Secret Key (Replace with a strong random string in production)
JWT_SECRET=super_secret_jobscout_jwt_key_india_2026_xyz

# Frontend URL for CORS (Allowing your production frontend domain to talk to backend)
# Example: https://jobscout.vercel.app or https://jobscout.onrender.com
# Leave blank or set to '*' to allow all origins
CLIENT_URL=https://localhost:5173

# ==============================================================
# ENTERPRISE SCALING & CLOUD INFRASTRUCTURE (Optional)
# ==============================================================
#
# 1. MongoDB Atlas Scaling (Automatic migration & 50,000+ active user cluster)
# If set, platform automatically uses MongoDB Atlas cluster with connection pooling.
# If omitted, platform gracefully defaults to zero-config Atomic JSON persistence.
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/jobscout?retryWrites=true&w=majority
#
# 2. Redis Multi-Node WebSocket Clustering (Horizontal scaling behind ALB / Load Balancers)
# If set, Socket.IO multi-node clustering adapter broadcasts WebRTC & Chat across all nodes.
# REDIS_URL=redis://default:password@redis-cloud-instance:6379
# Or:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
#
# 3. Cloud Media Storage (Cloudinary & AWS S3 / Cloudflare R2 / MinIO)
# If configured, resumes upload directly to S3 / Cloudflare R2, and video pitches stream via Cloudinary.
# If omitted, media stores locally in server/public/uploads with zero config.
#
# Cloudinary (Ideal for 60s Speed Elevator Pitch Videos & Avatars):
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# Or:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
#
# AWS S3 / Cloudflare R2 / MinIO (Ideal for PDF Resumes & Documents):
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=jobscout-resumes
# AWS_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com  (For Cloudflare R2)
# AWS_S3_PUBLIC_URL=https://resumes.jobscout.io

# ==============================================================
# OFFICIAL OFFER LETTER EMAIL CONFIGURATION (Optional for Real Gmail Inbox Delivery)
# ==============================================================
# If these are set, real emails are dispatched directly to the candidate's Gmail inbox.
# If omitted, emails are logged in server console + delivered instantly inside JobScout portal.
#
# Option A: Using Gmail (Fastest & Free)
# GMAIL_USER=yourbusiness@gmail.com
# GMAIL_PASS=xxxx xxxx xxxx xxxx  (16-character Google App Password)
#
# Option B: Using Custom SMTP (Brevo, SendGrid, Amazon SES, Mailgun, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourbusiness@gmail.com
# SMTP_PASS=your_smtp_password
# EMAIL_FROM="JobScout Hiring" <noreply@jobscout.io>
