# ==============================================================
# SERVER ENVIRONMENT CONFIGURATION (.env)
# ==============================================================

# Port to listen on (Default: 5000; on Render/Railway/Heroku $PORT is automatically injected)
PORT=5000

# Environment mode: production | development
NODE_ENV=production

# JWT Authentication Secret Key (Replace with a strong random string in production)
JWT_SECRET=super_secret_jobscout_jwt_key_india_2026_xyz

# Frontend URL for CORS (Allowing your production frontend domain to talk to backend)
# Example: https://jobscout.vercel.app or https://jobscout.onrender.com
# Leave blank or set to '*' to allow all origins
CLIENT_URL=https://localhost:5173

# Optional Persistent Database File Path (For Render Disks or VPS volumes)
# If left empty, defaults to server/data.json
# Example for Render Disk: /var/data/data.json
DATA_PATH=

# ==============================================================
# OFFICIAL OFFER LETTER EMAIL CONFIGURATION (Optional for Real Gmail Inbox Delivery)
# ==============================================================
# If these are set, real emails are dispatched directly to the candidate's Gmail inbox.
# If omitted, emails are logged in server console + delivered instantly inside JobScout portal.
#
# Option A: Using Gmail (Fastest & Free)
# GMAIL_USER=yourbusiness@gmail.com
# GMAIL_PASS=xxxx xxxx xxxx xxxx  (16-character Google App Password)
#
# Option B: Using Custom SMTP (Brevo, SendGrid, Amazon SES, Mailgun, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourbusiness@gmail.com
# SMTP_PASS=your_smtp_password
# EMAIL_FROM="JobScout Hiring" <noreply@jobscout.io>
