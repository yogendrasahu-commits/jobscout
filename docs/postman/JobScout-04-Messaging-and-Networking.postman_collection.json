  "info": {
    "_postman_id": "5b908e91-9d4c-4c68-8871-57a3e216392e",
    "name": "JobScout - Step 4: Messaging & Professional Network",
    "description": "Real-time in-app direct messaging, conversation history, unread counters, user network profiles, 1-tap connections, and professional skill endorsements.\n\nEnvironment Variables Used:\n- `{{baseUrl}}`: Base server URL\n- `{{token}}`: Active JWT session token\n- `{{jobId}}`: Target Job identifier\n- `{{applicationId}}`: Target Job Application identifier",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Send Direct Chat Message",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 or 201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "if (pm.response.code === 201) {",
              "    var res = pm.response.json();",
              "    var m = res.message || res;",
              "    if (m.id || m._id) {",
              "        pm.environment.set('messageId', m.id || m._id);",
              "        console.log('✅ messageId saved:', m.id || m._id);",
              "    }",
              "}",
              "pm.test('Response time < 1500ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1500);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "messages"
          ]
        },
        "description": "Send Direct Chat Message",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{seekerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"receiverId\": \"usr_seeker_1\",\n  \"text\": \"Hi Rahul, we reviewed your profile and would love to schedule a quick call!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
