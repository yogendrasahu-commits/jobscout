    "_postman_id": "735401df-d924-44bc-8ced-c1fca3569615",
    "name": "JobScout - Step 3: Employer Hiring & ATS Pipeline",
    "description": "Posting new verified tech jobs, browsing active talent on the interactive radar, reviewing candidate ATS pipelines, advancing candidate interview stages, and issuing stamped digital offer letters.\n\nEnvironment Variables Used:\n- `{{baseUrl}}`: Base server URL\n- `{{token}}`: Active JWT session token\n- `{{jobId}}`: Target Job identifier\n- `{{applicationId}}`: Target Job Application identifier",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Post a New Job Opening (Employer Only)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 or 201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "if (pm.response.code === 201) {",
              "    var res = pm.response.json();",
              "    var j = res.job || res;",
              "    if (j.id || j._id) {",
              "        pm.environment.set('jobId', j.id || j._id);",
              "        console.log('✅ jobId saved:', j.id || j._id);",
              "    }",
              "}",
              "pm.test('Response time < 1500ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1500);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/jobs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "jobs"
          ]
        },
        "description": "Post a New Job Opening (Employer Only)",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{employerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Fullstack Node & React Developer\",\n  \"company\": \"TechPulse Solutions\",\n  \"category\": \"Technology\",\n  \"jobType\": \"Full-time\",\n  \"salary\": \"₹15,00,000 - ₹20,00,000 / yr\",\n  \"lat\": 19.076,\n  \"lng\": 72.8777,\n  \"address\": \"BKC, Mumbai\",\n  \"description\": \"Lead fullstack development of our live radar maps.\",\n  \"skills\": [\n    \"React\",\n    \"Node.js\",\n    \"MongoDB\"\n  ],\n  \"urgent\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
