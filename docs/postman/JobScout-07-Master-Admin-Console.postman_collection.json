    "name": "JobScout - Step 7: Master Administration & Operations",
    "description": "Super admin platform governance: system analytics, user management, identity verification badges, account blocking, job moderation, geocoded map pins, dynamic feature flags, and global WebSocket broadcasts.\n\nEnvironment Variables Used:\n- `{{baseUrl}}`: Base server URL\n- `{{token}}`: Active JWT session token\n- `{{jobId}}`: Target Job identifier\n- `{{applicationId}}`: Target Job Application identifier",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Admin Master Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 or 201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    var res = pm.response.json();",
              "    if (res.token) {",
              "        pm.environment.set('token', res.token);",
              "        if (res.user) {",
              "            if (res.user.role === 'seeker') {",
              "                pm.environment.set('seekerToken', res.token);",
              "                pm.environment.set('seekerId', res.user.id || res.user._id);",
              "            } else if (res.user.role === 'emp') {",
              "                pm.environment.set('employerToken', res.token);",
              "                pm.environment.set('employerId', res.user.id || res.user._id);",
              "            } else if (res.user.role === 'admin') {",
              "                pm.environment.set('adminToken', res.token);",
              "                pm.environment.set('adminId', res.user.id || res.user._id);",
              "            }",
              "        }",
              "        console.log('✅ Token saved to environment variable');",
              "    }",
              "}",
              "pm.test('Response time < 1500ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1500);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login-phone-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login-phone-password"
          ]
        },
        "description": "Login with Phone Number & Password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"9999999999\",\n  \"password\": \"AdminMasterPass123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
