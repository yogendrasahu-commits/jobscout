              "});",
              "if (pm.response.code === 201) {",
              "    var res = pm.response.json();",
              "    var p = res.post || res;",
              "    if (p.id || p._id) {",
              "        pm.environment.set('postId', p.id || p._id);",
              "        console.log('✅ postId saved:', p.id || p._id);",
              "    }",
