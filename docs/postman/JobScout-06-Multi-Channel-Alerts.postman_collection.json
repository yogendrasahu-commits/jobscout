    "name": "JobScout - Step 6: Instant Alerts & Notification Engine",
    "description": "Automated multi-channel alert dispatch via direct WhatsApp click-to-chat links, Telegram bot webhooks, notification preference controls, and SMTP email settings.\n\nEnvironment Variables Used:\n- `{{baseUrl}}`: Base server URL\n- `{{token}}`: Active JWT session token\n- `{{jobId}}`: Target Job identifier\n- `{{applicationId}}`: Target Job Application identifier",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Generate Direct WhatsApp Notification Link",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 or 201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "pm.test('Response time < 1500ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1500);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/alerts/whatsapp",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "alerts",
            "whatsapp"
          ]
        },
        "description": "Generate Direct WhatsApp Notification Link",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+91-9876543210\",\n  \"message\": \"Your job application has been reviewed by TechPulse Solutions!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
