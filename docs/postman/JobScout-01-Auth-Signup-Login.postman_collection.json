    {
      "name": "Register Job Seeker (via Phone OTP)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 or 201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    var res = pm.response.json();",
              "    if (res.token) {",
              "        pm.environment.set('token', res.token);",
              "        if (res.user) {",
              "            if (res.user.role === 'seeker') {",
              "                pm.environment.set('seekerToken', res.token);",
              "                pm.environment.set('seekerId', res.user.id || res.user._id);",
              "            } else if (res.user.role === 'emp') {",
              "                pm.environment.set('employerToken', res.token);",
              "                pm.environment.set('employerId', res.user.id || res.user._id);",
              "            } else if (res.user.role === 'admin') {",
              "                pm.environment.set('adminToken', res.token);",
              "                pm.environment.set('adminId', res.user.id || res.user._id);",
              "            }",
              "        }",
              "        console.log('✅ Token saved to environment variable');",
              "    }",
              "}",
              "pm.test('Response time < 1500ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1500);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
