      "name": "List Jobs with Search & Distance Radius Filters",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is successful (< 400)', function () {",
              "    pm.expect(pm.response.code).to.be.below(400);",
              "});",
              "pm.test('Response time < 1500ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1500);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/jobs?search=&category=&lat=&lng=&radius=",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "jobs"
          ],
          "query": [
            {
              "key": "search",
              "value": "",
              "description": "Filter by title, company, or skills"
            },
            {
              "key": "category",
              "value": "",
              "description": "Filter by category (Technology, Design, etc.)"
            },
            {
              "key": "lat",
              "value": "",
              "description": "User latitude for Haversine distance calculation"
            },
            {
              "key": "lng",
              "value": "",
              "description": "User longitude"
            },
            {
              "key": "radius",
              "value": "",
              "description": "Radar radius in kilometers (e.g. 10)"
            }
          ]
        },
        "description": "List Jobs with Search & Distance Radius Filters"
      }
