    {
      "name": "Submit Application for a Job (Seeker Only)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 or 201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "if (pm.response.code === 201) {",
              "    var res = pm.response.json();",
              "    var app = res.application || res;",
              "    if (app.id || app._id) {",
              "        pm.environment.set('applicationId', app.id || app._id);",
              "        console.log('✅ applicationId saved:', app.id || app._id);",
              "    }",
              "}",
              "pm.test('Response time < 1500ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1500);",
              "});"
            ]
          }
        }
      ],
