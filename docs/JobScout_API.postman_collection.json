              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    if (pm.environment) pm.environment.set('token', jsonData.token);",
                  "    console.log('✅ Token saved to {{token}}');",
