# ==============================================================
# CLIENT / FRONTEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================

# Backend API Base URL
# - Leave blank if Frontend is served from the same server as Backend (e.g. Render Fullstack)
# - Set to your deployed backend URL if Frontend is on Vercel/Netlify (e.g. https://jobscout-api.onrender.com)
VITE_API_URL=

# Socket.IO & WebRTC Signaling URL
# - Leave blank if Frontend and Backend share the same domain
# - Set to your deployed backend URL if decoupled (e.g. https://jobscout-api.onrender.com)
VITE_SOCKET_URL=
